.DS_Store
node_modules/

# Leftovers from the v0.3 sidecar, both dead as of v0.4 and both safe to delete.
# Kept ignored rather than dropped: vendor/ is the GPL-3.0 comic-text-detector
# checkout, and it is a git repo, so without this rule `git add -A` stages it as
# a gitlink — a GPL reference committed into an MIT tree.
/vendor/
/.venv/
__pycache__/
.pytest_cache/

# Model weights and ONNX runtime binaries — ~200MB of bake-off candidates plus
# the extension's own runtime. All reproducible from npm and pinned URLs, so
# they are fetched rather than committed:
#   tools/bakeoff/fetch-models.mjs
#   tools/bakeoff/install-extension-assets.mjs
/weights/
/extension/vendor/ort/*.wasm
/extension/vendor/ort/*.mjs
/extension/models/*.onnx

# tools/ is scratch space, EXCEPT the bake-off harness, which is real source.
# Written as /tools/* rather than /tools because git cannot re-include anything
# inside a directory that has itself been excluded — `!/tools/bakeoff/` under a
# bare `/tools` rule is silently ignored.
/tools/*
!/tools/bakeoff/

# Bake-off fixtures: the pages are committed so comparisons are reproducible,
# the renders they generate are not.
/fixtures/out/
